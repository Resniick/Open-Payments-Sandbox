<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="BankRepository.fs" />
        <Compile Include="Database\DatabaseUpgrader.fs" />
    </ItemGroup>
    
    <ItemGroup>
        <EmbeddedResource Include="Database\Importers\*.sql" LogicalName="Importers.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Database\Migrations\*.sql" LogicalName="Migrations.%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenPayments.Sandbox.Core\OpenPayments.Sandbox.Core.fsproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="dbup-postgresql" Version="7.0.1" />
      <PackageReference Include="Npgsql.FSharp" Version="8.0.0" />
    </ItemGroup>

</Project>
